# ============================================================================
# SignalK connection
# ============================================================================

# Base URL of the SignalK server, reachable from inside this container.
# Leave blank to disable the SignalK source (e.g. USB GPS / Starlink only).
# Use the SignalK host's LAN IP or hostname, e.g.:
#   SIGNALK_URL=http://192.168.1.50:3000
#   SIGNALK_URL=http://signalk.local:3000
#
# If SignalK runs on the SAME host as this container in `network_mode: host`,
# you can alternatively add this to docker-compose.yml:
#   extra_hosts:
#     - "host.docker.internal:host-gateway"
# and then use:
#   SIGNALK_URL=http://host.docker.internal:3000
SIGNALK_URL=http://CHANGE_ME:3000

# SignalK path that contains an ISO 8601 datetime string from GPS.
# Default is the standard path; override only if your GPS publishes time elsewhere.
SIGNALK_PATH=navigation.datetime

# ----------------------------------------------------------------------------
# Auth (choose ONE mode, or leave all blank for no-auth / readonly access)
# ----------------------------------------------------------------------------

# Mode 1 (recommended for LAN): leave all auth vars blank. Requires SignalK
# to have "Allow Readonly Access" enabled, or security disabled.

# Mode 2: username/password
# SIGNALK_USERNAME=
# SIGNALK_PASSWORD=

# Mode 3: device access request. First run requires approval in SignalK UI
# (Security -> Access Requests). Token persisted at /data/signalk-token.
# SIGNALK_REQUEST_ACCESS=true

# ============================================================================
# USB GPS puck (optional)
# ============================================================================

# Path INSIDE the container to a USB GPS receiver speaking NMEA 0183 (u-blox
# VK-162/VK-172, GlobalSat BU-353, etc.). Also uncomment the `devices:` block
# in docker-compose.yml to pass the puck through. Leave blank to disable.
# USB_GPS_DEVICE=/dev/gps0

# Serial baud rate. Leave blank to auto-detect (tries 9600, 4800, 38400,
# 115200). Ignored by CDC-ACM pucks that show up as /dev/ttyACM*.
# USB_GPS_BAUD=

# Seconds between the top of each second and the NMEA sentence for it
# arriving. Subtracted from every sample. Calibrate against Starlink or the
# pool: set it to the USB GPS source's typical "Last sample" offset in the
# web UI (e.g. +118ms -> 0.118). Blank = 0.
# USB_GPS_OFFSET=

# ============================================================================
# NTP server behaviour
# ============================================================================

# Comma-separated CIDRs allowed to query us. Adjust to your LAN.
NTP_ALLOW_SUBNETS=192.168.0.0/16,10.0.0.0/8

# Fallback NTP pool used when GPS sources are unavailable. Leave blank to
# disable (e.g. if the boat is always off-grid and you want GPS-only).
# If you use Starlink (STARLINK_NTP_IP below), a pool is usually redundant.
NTP_FALLBACK_POOL=pool.ntp.org

# Optional: Starlink dish NTP server. Starlink terminals run a stratum-1 NTP
# server serving GPS time on their LAN (as of Sept 2024). Set to the dish's
# IP (usually 192.168.100.1) to have chrony use it as a time source. Leave
# blank to disable. Requires the dish to be on the same LAN as this container.
STARLINK_NTP_IP=

# If "true", chrony will step/slew the host clock (requires CAP_SYS_TIME,
# already granted in docker-compose.yml). If "false", chrony serves NTP but
# does not touch the host clock.
SET_HOST_CLOCK=false

# ============================================================================
# Misc
# ============================================================================

# Path inside the container to a file containing the host's IANA timezone name
# (e.g. "America/Los_Angeles"). /etc/timezone is standard on most Linux hosts
# and is bind-mounted read-only in docker-compose.yml. Override if your host
# uses a different path.
HOST_TZ_FILE=/etc/timezone

LOG_LEVEL=INFO
